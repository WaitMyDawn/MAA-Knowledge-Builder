<configuration>
    <!-- 评测/自动化场景下 runId/dialogueId/turnId 由 MDC 注入；空值时输出 "-" -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{runId:--}/%X{dialogueId:--}/%X{turnId:--}] %logger{36} - %msg%n"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 调试 Agent 提示词：打开四个 Agent 的 DEBUG，输出完整 prompt -->
    <logger name="yagen.waitmydawn.kb.agent.ClassifyAgent" level="DEBUG" />
    <logger name="yagen.waitmydawn.kb.agent.EntityAgent" level="DEBUG" />
    <logger name="yagen.waitmydawn.kb.agent.UrlAgent" level="DEBUG" />
    <logger name="yagen.waitmydawn.kb.agent.AnswerAgent" level="DEBUG" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
