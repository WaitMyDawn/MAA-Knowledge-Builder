{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MKB-Export v2 exact GUI item states",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "origin",
    "exporter",
    "environment",
    "rendering",
    "icons"
  ],
  "properties": {
    "format": {
      "const": "mkb-export"
    },
    "schemaVersion": {
      "const": 2
    },
    "origin": {
      "enum": [
        "GAME_GUI",
        "FIXTURE"
      ]
    },
    "exportedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "mkb_export"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minecraftVersion",
        "loader",
        "loaderVersion",
        "mods",
        "resourcePacks"
      ],
      "properties": {
        "language": {"type": "string", "pattern": "^[a-z0-9_]+$", "maxLength": 32},
        "minecraftVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "loader": {
          "enum": [
            "neoforge",
            "forge",
            "fabric",
            "quilt",
            "vanilla"
          ]
        },
        "loaderVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mods": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_.-]+$",
                "maxLength": 255
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "resourcePacks": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "width",
        "height",
        "background"
      ],
      "properties": {
        "context": {
          "const": "GUI"
        },
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 512
        },
        "background": {
          "const": "transparent"
        }
      },
      "description": "width and height must also be equal; the importer validates decoded PNG dimensions and alpha."
    },
    "icons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "variant",
              "status",
              "file",
              "sha256"
            ],
            "properties": {
              "itemId": {
                "$ref": "#/$defs/itemId"
              },
              "variant": {
                "type": "string",
                "pattern": "^(default|state:[0-9a-f]{64})$"
              },
              "status": {
                "enum": ["OK", "TRANSPARENT"]
              },
              "file": {
                "type": "string",
                "pattern": "^icons/.*\\.png$",
                "maxLength": 1000
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "state": {
                "$ref": "#/$defs/state"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "variant": {
                      "const": "default"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "state"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "state"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "itemId",
              "variant",
              "status",
              "error"
            ],
            "properties": {
              "itemId": {
                "$ref": "#/$defs/itemId"
              },
              "variant": {
                "type": "string",
                "pattern": "^(default|state:[0-9a-f]{64})$"
              },
              "status": {
                "enum": [
                  "FAILED",
                  "UNSUPPORTED"
                ]
              },
              "error": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "state": {
                "$ref": "#/$defs/state"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "variant": {
                      "const": "default"
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "state"
                    ]
                  }
                },
                "else": {
                  "required": [
                    "state"
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "itemId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "maxLength": 500,
      "not": {
        "pattern": "\\.\\."
      }
    },
    "state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "components"
          ],
          "properties": {
            "components": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nbt"
          ],
          "properties": {
            "nbt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        }
      ]
    }
  },
  "description": "State variants use SHA-256 of canonical JSON with sorted object keys. The importer also verifies this hash, bounded state size, unique (itemId, variant), PNG dimensions and alpha."
}
